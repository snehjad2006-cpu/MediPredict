-- =========================================================
-- MediPredict - MySQL Schema
-- Future persistence layer for the JDBC DAO classes.
-- The default demo build runs on an in-memory DataStore, so
-- installing MySQL is OPTIONAL - only required if you want to
-- move to the real database-backed DAO/JDBC layer.
-- =========================================================

CREATE DATABASE IF NOT EXISTS medipredict CHARACTER SET utf8mb4;
USE medipredict;

-- ---------- Pharmacies ----------
CREATE TABLE IF NOT EXISTS pharmacies (
    pharmacy_id   VARCHAR(10)  PRIMARY KEY,
    name          VARCHAR(100) NOT NULL,
    location      VARCHAR(150)
) ENGINE=InnoDB;

-- ---------- Users ----------
CREATE TABLE IF NOT EXISTS users (
    user_id        VARCHAR(10)  PRIMARY KEY,
    username       VARCHAR(50)  NOT NULL UNIQUE,
    password_hash  VARCHAR(64)  NOT NULL,      -- SHA-256 hex digest, never plaintext
    role           ENUM('ADMIN','PHARMACIST') NOT NULL,
    pharmacy_id    VARCHAR(10),
    CONSTRAINT fk_users_pharmacy FOREIGN KEY (pharmacy_id) REFERENCES pharmacies(pharmacy_id)
) ENGINE=InnoDB;

-- ---------- Suppliers ----------
CREATE TABLE IF NOT EXISTS suppliers (
    supplier_id    VARCHAR(10)  PRIMARY KEY,
    name           VARCHAR(100) NOT NULL,
    lead_time_days INT NOT NULL DEFAULT 7 CHECK (lead_time_days >= 0)
) ENGINE=InnoDB;

-- ---------- Medicines ----------
CREATE TABLE IF NOT EXISTS medicines (
    medicine_id      VARCHAR(10)   PRIMARY KEY,
    name             VARCHAR(100)  NOT NULL,
    category         VARCHAR(50),
    is_essential     BOOLEAN       NOT NULL DEFAULT FALSE,
    unit_price       DECIMAL(10,2) NOT NULL CHECK (unit_price >= 0),
    min_stock_level  INT           NOT NULL DEFAULT 0 CHECK (min_stock_level >= 0),
    reorder_level    INT           NOT NULL DEFAULT 0 CHECK (reorder_level >= 0),
    INDEX idx_medicine_name (name)
) ENGINE=InnoDB;

-- ---------- Inventory Batches ----------
CREATE TABLE IF NOT EXISTS inventory_batches (
    batch_id        VARCHAR(10)   PRIMARY KEY,
    medicine_id     VARCHAR(10)   NOT NULL,
    quantity        INT           NOT NULL CHECK (quantity >= 0),
    expiry_date     DATE          NOT NULL,
    purchase_price  DECIMAL(10,2) NOT NULL CHECK (purchase_price >= 0),
    supplier_id     VARCHAR(10),
    pharmacy_id     VARCHAR(10)   NOT NULL,
    CONSTRAINT fk_batch_medicine FOREIGN KEY (medicine_id) REFERENCES medicines(medicine_id),
    CONSTRAINT fk_batch_supplier FOREIGN KEY (supplier_id) REFERENCES suppliers(supplier_id),
    CONSTRAINT fk_batch_pharmacy FOREIGN KEY (pharmacy_id) REFERENCES pharmacies(pharmacy_id),
    INDEX idx_batch_expiry (expiry_date),
    INDEX idx_batch_medicine (medicine_id)
) ENGINE=InnoDB;

-- ---------- Sales Records ----------
CREATE TABLE IF NOT EXISTS sales_records (
    sale_id       VARCHAR(10)  PRIMARY KEY,
    medicine_id   VARCHAR(10)  NOT NULL,
    quantity_sold INT          NOT NULL CHECK (quantity_sold > 0),
    sale_date     DATE         NOT NULL,
    pharmacy_id   VARCHAR(10)  NOT NULL,
    CONSTRAINT fk_sale_medicine FOREIGN KEY (medicine_id) REFERENCES medicines(medicine_id),
    CONSTRAINT fk_sale_pharmacy FOREIGN KEY (pharmacy_id) REFERENCES pharmacies(pharmacy_id),
    INDEX idx_sales_medicine_date (medicine_id, sale_date)
) ENGINE=InnoDB;

-- ---------- Reorder Recommendations ----------
CREATE TABLE IF NOT EXISTS reorder_recommendations (
    recommendation_id   INT AUTO_INCREMENT PRIMARY KEY,
    medicine_id          VARCHAR(10) NOT NULL,
    current_stock         INT NOT NULL,
    predicted_demand      DECIMAL(10,2) NOT NULL,
    recommended_order_qty INT NOT NULL,
    priority               ENUM('LOW','MEDIUM','HIGH','CRITICAL') NOT NULL,
    status                 ENUM('PENDING','APPROVED','REJECTED') NOT NULL DEFAULT 'PENDING',
    created_at             TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_reorder_medicine FOREIGN KEY (medicine_id) REFERENCES medicines(medicine_id)
) ENGINE=InnoDB;

-- ---------- Alerts ----------
CREATE TABLE IF NOT EXISTS alerts (
    alert_id     VARCHAR(10) PRIMARY KEY,
    type         ENUM('STOCKOUT','EXPIRY','ANOMALY','TRANSFER_SUGGESTION','PRIORITY') NOT NULL,
    severity     ENUM('LOW','MEDIUM','HIGH','CRITICAL') NOT NULL,
    medicine_id  VARCHAR(10) NOT NULL,
    message      VARCHAR(500) NOT NULL,
    created_at   TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_alert_medicine FOREIGN KEY (medicine_id) REFERENCES medicines(medicine_id)
) ENGINE=InnoDB;

-- ---------- Stock Transfers ----------
CREATE TABLE IF NOT EXISTS stock_transfers (
    transfer_id      INT AUTO_INCREMENT PRIMARY KEY,
    medicine_id      VARCHAR(10) NOT NULL,
    from_pharmacy_id VARCHAR(10) NOT NULL,
    to_pharmacy_id   VARCHAR(10) NOT NULL,
    quantity         INT NOT NULL CHECK (quantity > 0),
    status           ENUM('SUGGESTED','APPROVED','REJECTED','COMPLETED') NOT NULL DEFAULT 'SUGGESTED',
    created_at       TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_transfer_medicine FOREIGN KEY (medicine_id) REFERENCES medicines(medicine_id),
    CONSTRAINT fk_transfer_from FOREIGN KEY (from_pharmacy_id) REFERENCES pharmacies(pharmacy_id),
    CONSTRAINT fk_transfer_to FOREIGN KEY (to_pharmacy_id) REFERENCES pharmacies(pharmacy_id)
) ENGINE=InnoDB;

