enum Role { ADMIN, PHARMACIST }

class User {
    private final String username;
    private String password; // demo only: plaintext is NOT how this would work in production
    private final Role role;
    private final String pharmacyId;

    User(String username, String password, Role role, String pharmacyId) {
        this.username = username;
        this.password = hash(password);
        this.role = role;
        this.pharmacyId = pharmacyId;
    }

    // Simple, deterministic obfuscation so we are not storing raw plaintext in memory.
    // (A real system would use bcrypt/argon2 + salt; this keeps the file dependency-free.)
    private static String hash(String raw) {
        int h = 0;
        for (char c : raw.toCharArray()) h = h * 31 + c;
        return Integer.toHexString(h);
    }

    boolean checkPassword(String raw) { return this.password.equals(hash(raw)); }
    String getUsername() { return username; }
    Role getRole() { return role; }
    String getPharmacyId() { return pharmacyId; }
}

class Pharmacy {
    final String id;
    final String name;
    final String location;

    Pharmacy(String id, String name, String location) {
        this.id = id; this.name = name; this.location = location;
    }

    @Override public String toString() { return id + " - " + name + " (" + location + ")"; }
}

class Supplier {
    final String id;
    final String name;
    final int leadTimeDays;

    Supplier(String id, String name, int leadTimeDays) {
        this.id = id; this.name = name; this.leadTimeDays = leadTimeDays;
    }
}

class Medicine {
    final String id;
    final String name;
    final String category;
    final boolean essential;
    final double unitPrice;
    final int minStockLevel;
    final int reorderLevel;
    double seasonalFactor = 1.0; // configurable local demand signal

    Medicine(String id, String name, String category, boolean essential,
             double unitPrice, int minStockLevel, int reorderLevel) {
        this.id = id;
        this.name = name;
        this.category = category;
        this.essential = essential;
        this.unitPrice = unitPrice;
        this.minStockLevel = minStockLevel;
        this.reorderLevel = reorderLevel;
    }
}

class InventoryBatch {
    final String batchId;
    final String medicineId;
    int quantity;
    final LocalDate expiryDate;
    final double purchasePrice;
    final String supplierId;
    final String pharmacyId;

    InventoryBatch(String batchId, String medicineId, int quantity, LocalDate expiryDate,
                    double purchasePrice, String supplierId, String pharmacyId) {
        if (quantity < 0) throw new ValidationException("Batch quantity cannot be negative.");
        this.batchId = batchId;
        this.medicineId = medicineId;
        this.quantity = quantity;
        this.expiryDate = expiryDate;
        this.purchasePrice = purchasePrice;
        this.supplierId = supplierId;
        this.pharmacyId = pharmacyId;
    }

    long daysUntilExpiry() { return ChronoUnit.DAYS.between(LocalDate.now(), expiryDate); }
}

class SalesRecord {
    final String saleId;
    final String medicineId;
    final int quantitySold;
    final LocalDate date;
    final String pharmacyId;

    SalesRecord(String saleId, String medicineId, int quantitySold, LocalDate date, String pharmacyId) {
        if (quantitySold <= 0) throw new ValidationException("Quantity sold must be positive.");
        this.saleId = saleId;
        this.medicineId = medicineId;
        this.quantitySold = quantitySold;
        this.date = date;
        this.pharmacyId = pharmacyId;
    }
}

enum RiskLevel { LOW, MEDIUM, HIGH, CRITICAL }

/* ============================================================================
 *  DATA STORE  (medipredict.dao + medipredict.database, in-memory)
 *  Swap this class's internals for real JDBC DAOs later without touching
 *  the service layer below - all services only depend on these public
 *  read/write methods.
 * ========================================================================== */
class DataStore {
    final Map<String, User> users = new LinkedHashMap<>();
    final Map<String, Pharmacy> pharmacies = new LinkedHashMap<>();
    final Map<String, Supplier> suppliers = new LinkedHashMap<>();
    final Map<String, Medicine> medicines = new LinkedHashMap<>();
    final List<InventoryBatch> batches = new ArrayList<>();
    final List<SalesRecord> sales = new ArrayList<>();

    private int saleCounter = 1;
    private int batchCounter = 1;

    // ---- CRUD: Medicine ----
    void addMedicine(Medicine m) {
        if (medicines.containsKey(m.id)) throw new ValidationException("Duplicate medicine ID: " + m.id);
        medicines.put(m.id, m);
        AppLogger.log("Medicine added: " + m.id + " - " + m.name);
    }

    Medicine getMedicine(String id) {
        Medicine m = medicines.get(id);
        if (m == null) throw new ValidationException("Medicine not found: " + id);
        return m;
    }

    List<Medicine> searchMedicine(String keyword) {
        List<Medicine> result = new ArrayList<>();
        String k = keyword.toLowerCase();
        for (Medicine m : medicines.values()) {
            if (m.name.toLowerCase().contains(k) || m.id.toLowerCase().contains(k) || m.category.toLowerCase().contains(k)) {
                result.add(m);
            }
        }
        return result;
    }

    void deleteMedicine(String id) {
        if (medicines.remove(id) == null) throw new ValidationException("Medicine not found: " + id);
        batches.removeIf(b -> b.medicineId.equals(id));
        AppLogger.log("Medicine deleted: " + id);
    }

    // ---- Inventory batches ----
    InventoryBatch addBatch(String medicineId, int quantity, LocalDate expiry,
                             double purchasePrice, String supplierId, String pharmacyId) {
        getMedicine(medicineId); // validates existence
        if (expiry.isBefore(LocalDate.now())) throw new ValidationException("Expiry date cannot be in the past.");
        String id = "B" + String.format("%04d", batchCounter++);
        InventoryBatch batch = new InventoryBatch(id, medicineId, quantity, expiry, purchasePrice, supplierId, pharmacyId);
        batches.add(batch);
        AppLogger.log("Batch added: " + id + " for medicine " + medicineId + " qty=" + quantity);
        return batch;
    }

    /** Total usable (non-expired) stock for a medicine across all pharmacies, or filtered to one. */
    int usableStock(String medicineId, String pharmacyIdOrNull) {
        int total = 0;
        for (InventoryBatch b : batches) {
            if (!b.medicineId.equals(medicineId)) continue;
            if (pharmacyIdOrNull != null && !b.pharmacyId.equals(pharmacyIdOrNull)) continue;
            if (b.expiryDate.isBefore(LocalDate.now())) continue; // expired stock is not usable
            total += b.quantity;
        }
        return total;
    }

    List<InventoryBatch> batchesFor(String medicineId, String pharmacyIdOrNull) {
        List<InventoryBatch> result = new ArrayList<>();
        for (InventoryBatch b : batches) {
            if (!b.medicineId.equals(medicineId)) continue;
            if (pharmacyIdOrNull != null && !b.pharmacyId.equals(pharmacyIdOrNull)) continue;
            result.add(b);
        }
        return result;
    }

    /** FEFO (First Expiry, First Out) sale: deducts from the earliest-expiring batches first. */
    void recordSaleFEFO(String medicineId, int qty, LocalDate date, String pharmacyId) {
        getMedicine(medicineId);
        if (qty <= 0) throw new ValidationException("Sale quantity must be positive.");

        List<InventoryBatch> candidates = batchesFor(medicineId, pharmacyId);
        candidates.removeIf(b -> b.expiryDate.isBefore(LocalDate.now()) || b.quantity <= 0);
        candidates.sort(Comparator.comparing(b -> b.expiryDate)); // FEFO ordering

        int remaining = qty;
        for (InventoryBatch b : candidates) {
            if (remaining <= 0) break;
            int deduct = Math.min(remaining, b.quantity);
            b.quantity -= deduct;
            remaining -= deduct;
        }
        if (remaining > 0) {
            throw new ValidationException("Insufficient usable stock for " + medicineId
                    + " at " + pharmacyId + ". Short by " + remaining + " units.");
        }

        String saleId = "S" + String.format("%05d", saleCounter++);
        sales.add(new SalesRecord(saleId, medicineId, qty, date, pharmacyId));
        AppLogger.log("Sale recorded: " + saleId + " medicine=" + medicineId + " qty=" + qty + " pharmacy=" + pharmacyId);
    }

    List<SalesRecord> salesFor(String medicineId, String pharmacyIdOrNull) {
        List<SalesRecord> result = new ArrayList<>();
        for (SalesRecord s : sales) {
            if (!s.medicineId.equals(medicineId)) continue;
            if (pharmacyIdOrNull != null && !s.pharmacyId.equals(pharmacyIdOrNull)) continue;
            result.add(s);
        }
        return result;
    }

    /* ---- Demo data seeding ---- */
    static DataStore seedDemoData() {
        DataStore ds = new DataStore();

        ds.users.put("admin", new User("admin", "admin123", Role.ADMIN, null));
        ds.users.put("pharmacist", new User("pharmacist", "pharma123", Role.PHARMACIST, "PH01"));

        ds.pharmacies.put("PH01", new Pharmacy("PH01", "Jan Aushadhi Kendra - Bhopal Central", "Bhopal"));
        ds.pharmacies.put("PH02", new Pharmacy("PH02", "Jan Aushadhi Kendra - Indore East", "Indore"));

        ds.suppliers.put("SUP1", new Supplier("SUP1", "MedSource Distributors", 5));
        ds.suppliers.put("SUP2", new Supplier("SUP2", "PharmaLink Wholesale", 8));

        Object[][] meds = {
                // id,   name,                    category,          essential, price, minStock, reorderLevel, seasonalFactor
                {"M01", "Paracetamol 500mg",       "Analgesic",        true,  1.5,  50,  80, 1.0},
                {"M02", "ORS Sachets",              "Rehydration",      true,  5.0,  40,  60, 1.4},
                {"M03", "Amoxicillin 250mg",        "Antibiotic",       true,  3.0,  30,  50, 1.1},
                {"M04", "Cetirizine 10mg",          "Antihistamine",    false, 1.0,  30,  40, 1.6},
                {"M05", "Ibuprofen 400mg",          "Analgesic",        true,  2.0,  40,  60, 1.0},
                {"M06", "Azithromycin 500mg",       "Antibiotic",       true,  8.0,  20,  35, 1.0},
                {"M07", "Antacid Suspension",       "Gastro",           false, 4.0,  25,  35, 1.0},
                {"M08", "Iron Supplements",         "Supplement",       true,  2.5,  30,  45, 1.0},
                {"M09", "Vitamin D3",               "Supplement",       false, 3.5,  20,  30, 1.0},
                {"M10", "Metformin 500mg",          "Diabetes",         true,  2.2,  35,  55, 1.0},
                {"M11", "Glimepiride 2mg",          "Diabetes",         true,  4.5,  20,  30, 1.0},
                {"M12", "Cough Syrup",              "Respiratory",      false, 6.0,  15,  25, 1.5},
        };

        for (Object[] row : meds) {
            Medicine m = new Medicine((String) row[0], (String) row[1], (String) row[2],
                    (Boolean) row[3], (Double) row[4], (Integer) row[5], (Integer) row[6]);
            m.seasonalFactor = (Double) row[7];
            ds.addMedicine(m);
        }

        // Batches: a mix of comfortable stock, low stock, and near-expiry stock, split across 2 pharmacies.
        Random rnd = new Random(42);
        for (Medicine m : ds.medicines.values()) {
            ds.addBatch(m.id, 60 + rnd.nextInt(80), LocalDate.now().plusDays(120 + rnd.nextInt(200)),
                    m.unitPrice * 0.6, "SUP1", "PH01");
            ds.addBatch(m.id, 20 + rnd.nextInt(30), LocalDate.now().plusDays(200 + rnd.nextInt(150)),
                    m.unitPrice * 0.6, "SUP2", "PH02");
        }
        // A few deliberately low-stock / near-expiry batches to make forecasting demo meaningful.
        ds.addBatch("M01", 12, LocalDate.now().plusDays(20), 0.9, "SUP1", "PH01"); // near expiry
        ds.addBatch("M06", 8, LocalDate.now().plusDays(400), 5.0, "SUP2", "PH01");  // low stock
        ds.addBatch("M12", 10, LocalDate.now().plusDays(15), 3.6, "SUP1", "PH02");  // near expiry

        // Sales history: 30 days of semi-randomized sales per medicine per pharmacy,
        // with an intentional demand spike for M04 (Cetirizine) in the last 7 days
        // and a seasonal item (M02 ORS) trending up, to demonstrate anomaly detection.
        for (Medicine m : ds.medicines.values()) {
            for (String pharmacyId : new String[]{"PH01", "PH02"}) {
                int baseDaily = 2 + rnd.nextInt(5);
                for (int daysAgo = 30; daysAgo >= 1; daysAgo--) {
                    LocalDate date = LocalDate.now().minusDays(daysAgo);
                    int qty = Math.max(0, baseDaily + rnd.nextInt(3) - 1);

                    if (m.id.equals("M04") && daysAgo <= 7) qty += 6;           // sudden spike
                    if (m.id.equals("M02") && daysAgo <= 14) qty += 3;          // gradual seasonal rise

                    if (qty > 0) {
                        try {
                            ds.recordSaleFEFO(m.id, qty, date, pharmacyId);
                        } catch (ValidationException e) {
                            // Ran out of demo stock for that batch mix on this day; skip quietly.
                        }
                    }
                }
            }
        }

        AppLogger.log("Demo data seeded: " + ds.medicines.size() + " medicines, "
                + ds.batches.size() + " batches, " + ds.sales.size() + " sales records.");
        return ds;
    }
}

